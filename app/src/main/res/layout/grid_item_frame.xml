<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/frame_surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/frame_card_border"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Portrait Photo Tile -->
        <ImageView
            android:id="@+id/img_frame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/gallery_header"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/frame_coastal_cliff" />

        <!-- Top-Right Popup Menu Trigger with Dark Scrim -->
        <ImageButton
            android:id="@+id/btn_popup_menu"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_scrim_circle"
            android:contentDescription="@string/menu_image_details"
            android:padding="5dp"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/frame_text_primary" />

        <!-- Top-Left Selection Badge Indicator -->
        <ImageView
            android:id="@+id/img_selection_badge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_selection_badge"
            android:contentDescription="@string/status_selected"
            android:padding="4dp"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <!-- Subtitle & Title Bar -->
        <LinearLayout
            android:id="@+id/label_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#D9121215"
            android:orientation="vertical"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            app:layout_constraintBottom_toBottomOf="@id/img_frame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tv_frame_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/frame_text_primary"
                android:textSize="11sp"
                tools:text="Coastal Cliff" />

            <TextView
                android:id="@+id/tv_frame_filename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:maxLines="1"
                android:textColor="@color/frame_text_dim"
                android:textSize="9sp"
                tools:text="coastal_cliff.webp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>